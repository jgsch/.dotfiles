#!/bin/bash

declare -A SEARCHING_DIRS # path / depth search
SEARCHING_DIRS["${HOME}/Projects/asso"]="2"
SEARCHING_DIRS["${HOME}/Projects/work"]="1"
SEARCHING_DIRS["${HOME}/Projects/personnal"]="2"

DIRS="${HOME}/.dotfiles"
for DIR in "${!SEARCHING_DIRS[@]}"; do
  if [ -d $DIR ]; then
    DEPTH="${SEARCHING_DIRS[$DIR]}"
    DIRS="${DIRS} $(fd . ${DIR} --type directory --exact-depth ${DEPTH})"
  fi
done

SELECTED_DIR=$(printf "%s\n" ${DIRS} | fzf)
SELECTED_DIRNAME=$(basename "${SELECTED_DIR}" | tr . _)

TMUX_RUNNING=$(pgrep tmux)

if ! tmux has-session -t="${SELECTED_DIRNAME}" 2> /dev/null; then
  tmux new-session -ds "${SELECTED_DIRNAME}" -c "${SELECTED_DIR}"
  tmux split-window -v -t "${SELECTED_DIRNAME}" -c "${SELECTED_DIR}"
fi

if [[ -z ${TMUX} ]]; then
  tmux attach-session -t ${SELECTED_DIRNAME}
else
  tmux switch-client -t ${SELECTED_DIRNAME}
fi
